# Obsidian: keep the vault config (.obsidian/*.json, plugins, themes, snippets)
# but not per-user, per-device UI state or caches.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# OS
.DS_Store

# JetBrains (PyCharm): share the project config (.idea/*.iml, modules.xml,
# vcs.xml, inspectionProfiles, runConfigurations) so it opens anywhere,
# but not per-user state or per-machine settings.
.idea/workspace.xml
.idea/shelf/
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sqldialects.xml
.idea/copilot*
.idea/**/aws.xml
# misc.xml names the local Python interpreter; each machine sets its own.
.idea/misc.xml

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node / Astro
node_modules/
.astro/
playwright-report/
test-results/

# Local environment
.env
.env.*
!.env.example
