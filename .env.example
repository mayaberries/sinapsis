# Copy to `.env` only to change something: every value below is already the
# default, matching docker-compose.yml.

# Docker Compose
POSTGRES_USER=sinapsis
POSTGRES_PASSWORD=sinapsis
POSTGRES_DB=sinapsis
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend (read by backend/app/core/config.py)
DATABASE_URL=postgresql://sinapsis:sinapsis@localhost:5432/sinapsis
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:4321"]

# Frontend (read by Astro; PUBLIC_* reaches the browser)
PUBLIC_API_URL=http://localhost:8000
