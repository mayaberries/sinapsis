---
import DashboardSidebar from "../components/DashboardSidebar.astro";
import MaterialList from "../components/MaterialList.astro";
import UpNextBanner from "../components/UpNextBanner.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import { facilitator, materials, today, upNext, workshops } from "../data/demo";
import BaseLayout from "../layouts/BaseLayout.astro";

const START_HREF = "/session/demo?role=host";
const firstName = facilitator.name.split(" ")[0];
---

<!--
  The facilitator's dashboard. No island: demo data rendered on the server;
  filters and uploads are visual only until there's an API behind them.
-->
<BaseLayout title="Panel · Sinapsis">
  <div class="dash">
    <DashboardSidebar />

    <main class="dash-main">
      <header class="dash-header">
        <div>
          <h1>Hola, {firstName}</h1>
          <p class="muted">{today}</p>
        </div>
        <a class="btn btn-primary" href="#nuevo">+ Nuevo taller</a>
      </header>

      <UpNextBanner next={upNext} startHref={START_HREF} />

      <section id="talleres" aria-labelledby="ws-title">
        <div class="section-head">
          <h2 id="ws-title">Mis talleres</h2>
          <select class="input" aria-label="Filtrar talleres">
            <option>Todos</option>
            <option>Recurrentes</option>
            <option>Únicos</option>
            <option>Borradores</option>
          </select>
        </div>
        <div class="workshop-grid">
          {workshops.map((workshop) => <WorkshopCard workshop={workshop} startHref={START_HREF} />)}
        </div>
      </section>

      <section id="materiales" aria-labelledby="mat-title">
        <div class="section-head">
          <h2 id="mat-title">Materiales</h2>
          <select class="input" aria-label="Mostrar materiales de">
            <option>Todos los talleres</option>
            {workshops.map((workshop) => <option>{workshop.title}</option>)}
          </select>
        </div>

        <label class="dropzone">
          <span class="dropzone-icon" aria-hidden="true">⬆</span>
          <strong>Arrastra archivos aquí o haz clic para subirlos</strong>
          <span class="muted">PDF, imágenes, audio, video y presentaciones</span>
          <input type="file" multiple accept=".pdf,image/*,audio/*,video/*,.ppt,.pptx,.key,.odp" />
        </label>

        <div class="filters" role="group" aria-label="Filtrar por tipo">
          <button class="filter" type="button" aria-pressed="true">Todos</button>
          <button class="filter" type="button" aria-pressed="false">PDF</button>
          <button class="filter" type="button" aria-pressed="false">Imágenes</button>
          <button class="filter" type="button" aria-pressed="false">Audio</button>
          <button class="filter" type="button" aria-pressed="false">Video</button>
          <button class="filter" type="button" aria-pressed="false">Presentaciones</button>
        </div>

        <MaterialList materials={materials} />
      </section>

      <p class="muted demo-switch">
        Prototipo: <a href="/">ver la página de participantes</a>
      </p>
    </main>
  </div>
</BaseLayout>

<style>
  .dash {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 240px 1fr;
  }
  .dash-main {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }
  .dash-header,
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .section-head {
    margin-bottom: 16px;
  }
  .section-head h2 {
    margin: 0;
  }
  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 16px;
  }

  /* ---------- Materials ---------- */
  .dropzone {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 32px 16px;
    border: 3px dashed var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: center;
    cursor: pointer;
  }
  .dropzone:hover,
  .dropzone:focus-within {
    border-color: var(--primary);
    background: var(--primary-soft);
  }
  .dropzone input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .dropzone-icon {
    font-size: 36px;
  }
  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 16px 0;
  }
  .filter {
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 16px;
    cursor: pointer;
  }
  .filter[aria-pressed="true"] {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }
  .demo-switch {
    text-align: center;
  }

  @media (max-width: 860px) {
    .dash {
      grid-template-columns: 1fr;
    }
    .dash-main {
      padding: 20px 16px;
    }
  }
</style>
