{
  "openapi": "3.1.0",
  "info": {
    "title": "Sinapsis",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health:Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unreachable"
        ],
        "title": "CheckStatus"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OverallStatus"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthStatus"
      },
      "OverallStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "OverallStatus"
      }
    }
  }
}
